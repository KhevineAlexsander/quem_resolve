# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# QUEM RESOLVE - SUPABASE & MAPBOX CONFIG (100% SEM IA)
# ==========================================
# Insira a URL do seu projeto Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Insira a chave pública/anônima do Supabase (Project Settings > API > anon/public key)
# NUNCA insira a service_role key aqui!
VITE_SUPABASE_PUBLISHABLE_KEY=

# Insira seu token público do Mapbox (https://account.mapbox.com)
# Caso não configurado, o app usa visualização vetorial interativa integrada para Imperatriz - MA
VITE_MAPBOX_ACCESS_TOKEN=
