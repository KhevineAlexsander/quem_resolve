# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# QUEM RESOLVE - SUPABASE & GOOGLE MAPS CONFIG
# ==========================================
# Insira a URL do seu projeto Supabase (ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=

# Insira a chave pública/anônima do Supabase (Project Settings > API > anon/public key)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Chave de API do Google Maps Platform (Maps JavaScript API, Places API, Geocoding API)
VITE_GOOGLE_MAPS_API_KEY=
